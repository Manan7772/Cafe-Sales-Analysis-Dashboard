        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "1  Staff up for Friday to Sunday  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#4A2C1D",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "More than half of all sales happen on these three days, so plan cooks, servers and stock for them.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#5C4636"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "2  Never run out of main courses  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#4A2C1D",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Butter Chicken, Margherita Pizza and Veg Biryani make 49.0% of sales. Keep them in stock and feature them on the menu.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#5C4636"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "3  Sell meal combos  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#4A2C1D",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Pair a drink or dessert with each main course to raise the order value (now 1,155 per order).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#5C4636"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "4  Launch summer drink specials  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#4A2C1D",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Start cold-drink offers in April, when beverage sales rise from 14.1% to 23.1% of the total.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#5C4636"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "5  Fill the quiet weekdays  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#4A2C1D",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Run Monday to Thursday offers or happy hours to bring back the sales lost in 2024.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#5C4636"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
