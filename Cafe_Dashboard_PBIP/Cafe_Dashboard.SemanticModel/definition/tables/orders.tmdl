table orders
	lineageTag: 63fc5bec-535e-4899-b8a1-a488ba570f82

	measure 'Total Sales' = SUM(orders[Sales])
		formatString: 0.00,,"M"
		lineageTag: 129ad01a-cb04-4ba3-b658-5592e33d56c6

	measure 'Total Orders' = DISTINCTCOUNT(orders[OrderID])
		formatString: #,0
		lineageTag: ca9ea147-1563-465f-a3e1-e18c06f5be05

	measure 'Average Order Value' = DIVIDE([Total Sales],[Total Orders])
		formatString: #,0
		lineageTag: e601682f-68ae-4140-bf1d-f052f8574d48

	measure 'Units Sold' = SUM(orders[Quantity])
		formatString: #,0
		lineageTag: f307290c-5e84-4c7e-8e29-e7d9af66a9ce

	measure 'Main Course Share' = DIVIDE(CALCULATE([Total Sales],orders[Category]="Main Course"),[Total Sales])
		formatString: 0.0%
		lineageTag: 51885ec0-b486-41d1-92be-b525a3d01117

	measure 'Beverage Unit Share' = DIVIDE(CALCULATE([Units Sold],orders[Category]="Beverages"),[Units Sold])
		formatString: 0.0%
		lineageTag: 02697fac-0d5b-4aac-8afa-fc81720cacf2

	measure 'Fri to Sun Share' = DIVIDE(CALCULATE([Total Sales],orders[DayNum]>=5),[Total Sales])
		formatString: 0.0%
		lineageTag: e5ef07d0-8dcb-43a8-a543-fbfd11396f63

	measure 'Summer Beverage Share' = DIVIDE(CALCULATE([Total Sales],orders[Category]="Beverages",orders[MonthNum]>=4,orders[MonthNum]<=6),CALCULATE([Total Sales],orders[MonthNum]>=4,orders[MonthNum]<=6))
		formatString: 0.0%
		lineageTag: e38a4caa-c4bb-4242-b63e-5d098ecba993

	measure 'Sales 2023' = CALCULATE([Total Sales],orders[Year]=2023)
		formatString: 0.00,,"M"
		lineageTag: 943696f1-c684-4826-b2ad-5a5cd5c04d85

	measure 'Sales 2024' = CALCULATE([Total Sales],orders[Year]=2024)
		formatString: 0.00,,"M"
		lineageTag: a0a3cba3-031e-4528-8cfe-2a521cc9e926

	measure 'Sales Change 2024' = DIVIDE([Sales 2024]-[Sales 2023],[Sales 2023])
		formatString: +0.0%;-0.0%
		lineageTag: 5026802a-fa5d-4e28-89e2-9a13369b0008

	measure 'Day Bar Color' = IF(MAX(orders[DayNum])>=5,"#4A2C1D","#C8873A")
		lineageTag: 5b642fc8-8de3-4700-b853-01c7c1b28973

	column OrderID
		dataType: int64
		formatString: 0
		lineageTag: 442dfa93-3829-40d9-82be-0cb265cb5a40
		summarizeBy: none
		sourceColumn: OrderID

	column OrderDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: 7bcc5803-215e-4df7-8085-8eafc93a31c1
		summarizeBy: none
		sourceColumn: OrderDate

	column Category
		dataType: string
		lineageTag: 4fe3faf9-0606-496c-9124-c83c37a556ba
		summarizeBy: none
		sourceColumn: Category

	column Product
		dataType: string
		lineageTag: 958049de-2fd9-4662-b9cc-a8e77ffe3ca8
		summarizeBy: none
		sourceColumn: Product

	column Quantity
		dataType: int64
		formatString: 0
		lineageTag: 7eccda2d-822f-458b-b88f-9019a8d756cd
		summarizeBy: none
		sourceColumn: Quantity

	column UnitPrice
		dataType: double
		formatString: #,0
		lineageTag: 01792526-02d5-4427-810c-dbf4fc68d1fe
		summarizeBy: none
		sourceColumn: UnitPrice

	column Sales
		dataType: double
		formatString: #,0
		lineageTag: 44f4d9e9-537c-4757-a7a1-02c2eb1f8f82
		summarizeBy: none
		sourceColumn: Sales

	column MonthStart
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: ecd071b4-7df9-4e1f-a97b-48d4c52d0f3f
		summarizeBy: none
		sourceColumn: MonthStart

	column MonthNum
		dataType: int64
		formatString: 0
		lineageTag: fb7f6b7b-14cc-44ce-b6cd-37ed09b7faff
		summarizeBy: none
		sourceColumn: MonthNum

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 6a5148dc-c20a-4373-bafc-1f1fcb68b6dc
		summarizeBy: none
		sourceColumn: Year

	column DayNum
		dataType: int64
		formatString: 0
		lineageTag: 504bc434-6ee7-4109-a3c0-b4fe2d344879
		summarizeBy: none
		sourceColumn: DayNum

	column DayName
		dataType: string
		sortByColumn: DayNum
		lineageTag: 54823e12-a0d7-49f9-8d4c-132397530535
		summarizeBy: none
		sourceColumn: DayName

	partition orders = m
		mode: import
		source =
				let
				Source = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
				Raw = Table.FromRows(Source, {"OrderID","OrderDate","Category","Product","Quantity","UnitPrice"}),
				Typed = Table.TransformColumnTypes(Raw, {{"OrderID", Int64.Type}, {"OrderDate", type date}, {"Category", type text}, {"Product", type text}, {"Quantity", Int64.Type}, {"UnitPrice", type number}}, "en-US"),
				AddSales = Table.AddColumn(Typed, "Sales", each [Quantity] * [UnitPrice], type number),
				AddMonthStart = Table.AddColumn(AddSales, "MonthStart", each Date.StartOfMonth([OrderDate]), type date),
				AddMonthNum = Table.AddColumn(AddMonthStart, "MonthNum", each Date.Month([OrderDate]), Int64.Type),
				AddYear = Table.AddColumn(AddMonthNum, "Year", each Date.Year([OrderDate]), Int64.Type),
				AddDayNum = Table.AddColumn(AddYear, "DayNum", each Date.DayOfWeek([OrderDate], Day.Monday) + 1, Int64.Type),
				AddDayName = Table.AddColumn(AddDayNum, "DayName", each Date.ToText([OrderDate], "ddd", "en-US"), type text)
			in
				AddDayName

	annotation PBI_ResultType = Table
